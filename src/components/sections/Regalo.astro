---
import { Picture } from "astro:assets";
import ProductCard from "../ProductCard.astro";
import { getProductsInCollection } from "../../lib/catalog";
import { sections } from "../../content/sections";
import packaging from "../../assets/brand/packaging-bolsas.webp";

const products = (await getProductsInCollection("para-regalo")).slice(0, 4);
---

<section id="regalo" aria-labelledby="regalo-title" class="on-dark overflow-hidden bg-home-umber text-milk-paper">
  <div class="container-x grid gap-12 py-16 md:grid-cols-12 md:py-24">
    <div class="relative md:col-span-5">
      <Picture
        src={packaging}
        alt="Bolsas de regalo blancas de Milca con moño de cinta bordó"
        widths={[375, packaging.width]}
        sizes="(min-width: 768px) 40vw, 100vw"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        class="aspect-[4/5] w-full object-cover"
      />
      <svg class="pointer-events-none absolute -right-[30%] -top-[12%] w-[70%]" viewBox="0 0 200 200" aria-hidden="true">
        <circle cx="100" cy="100" r="99" fill="none" stroke="var(--color-fine-grey)" stroke-width="0.5" />
      </svg>
    </div>

    <div class="flex flex-col justify-center gap-12 md:col-span-6 md:col-start-7">
      <h2 id="regalo-title" class="display text-[clamp(56px,15vw,132px)] text-talent-peach">{sections.regalo.title}</h2>
      <p class="statement text-talent-peach">{sections.regalo.statement}</p>
      <p class="max-w-[46ch] text-milk-paper/85">{sections.regalo.text}</p>
      <a href="/?coleccion=para-regalo#catalogo" class="btn btn-outline self-start border-milk-paper text-milk-paper hover:bg-milk-paper hover:text-cocoa-ink">
        Ver piezas para regalo
      </a>
    </div>
  </div>

  {
    products.length > 0 && (
      <div class="bg-milk-paper py-12 text-cocoa-ink md:py-16">
        <ul class="container-x grid grid-cols-2 gap-x-12 gap-y-8 md:grid-cols-4" aria-label="Piezas para regalo">
          {products.map((p) => (
            <li>
              <ProductCard product={p} />
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>
