---
import { faq } from "../../content/faq";
import { sections } from "../../content/sections";
---

<section id="faq" aria-labelledby="faq-title" class="py-16 md:py-24">
  <div class="container-x grid gap-12 md:grid-cols-12">
    <h2 id="faq-title" class="statement md:col-span-4">{sections.faq.title}</h2>
    <div class="border-b border-cocoa-ink md:col-span-7 md:col-start-6">
      {
        faq.map((item) => (
          <details class="faq-item group border-t border-cocoa-ink" name="faq">
            <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-12 py-12 font-ui text-[16px] font-semibold [&::-webkit-details-marker]:hidden">
              {item.q}
              <span class="relative size-4 shrink-0" aria-hidden="true">
                <span class="absolute left-0 top-1/2 h-px w-4 bg-current" />
                <span class="absolute left-1/2 top-0 h-4 w-px bg-current transition-transform duration-300 group-open:rotate-90" />
              </span>
            </summary>
            <p class="max-w-[60ch] pb-12 text-cocoa-ink/80">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
