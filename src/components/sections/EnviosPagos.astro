---
import { sections } from "../../content/sections";
import { shipping } from "../../content/shipping";
import { payments } from "../../content/payments";
---

<section id="envios" aria-labelledby="envios-title" class="on-dark bg-shortlist-clay py-16 text-shortlist-cream md:py-24">
  <div class="container-x grid gap-12 md:grid-cols-12">
    <div class="flex flex-col gap-8 md:col-span-4">
      <h2 id="envios-title" class="statement" data-split="words">{sections.envios.title}</h2>
      <p class="text-shortlist-cream/85" data-reveal="up">{shipping.origin}</p>
    </div>

    <div class="grid gap-[36px] md:col-span-7 md:col-start-6 md:grid-cols-2 md:gap-12">
      <div class="flex flex-col gap-8">
        <h3 class="eyebrow text-talent-peach" data-reveal="fade">Envíos</h3>
        <ul class="flex flex-col gap-12" data-stagger="wipe">
          {
            shipping.items.map((s) => (
              <li class="flex flex-col gap-[2px] border-t border-shortlist-cream/30 pt-8">
                <p class="text-partner-label font-medium">{s.title}</p>
                <p class="text-shortlist-cream/85">{s.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex flex-col gap-8">
        <h3 class="eyebrow text-talent-peach" data-reveal="fade">Pagos</h3>
        <ul class="flex flex-col gap-12" data-stagger="wipe">
          {
            payments.methods.map((m) => (
              <li class="flex flex-col gap-[2px] border-t border-shortlist-cream/30 pt-8">
                <p class="text-partner-label font-medium">{m.title}</p>
                <p class="text-shortlist-cream/85">{m.text}</p>
              </li>
            ))
          }
        </ul>
        <p class="text-[13px] text-shortlist-cream/85" data-reveal="fade">{payments.note}</p>
      </div>
    </div>
  </div>
</section>
