---
import SectionTitle from "../SectionTitle.astro";
import { sections } from "../../content/sections";

const { comoComprar } = sections;
---

<section id="como-comprar" aria-labelledby="como-comprar-title" class="bg-join-blush py-16 md:py-24">
  <div class="container-x flex flex-col gap-12">
    <SectionTitle id="como-comprar-title" variant="statement" eyebrow="En 4 pasos">{comoComprar.title}</SectionTitle>
    <ol class="grid grid-cols-2 gap-x-12 gap-y-8 md:grid-cols-4" data-stagger="wipe">
      {
        comoComprar.steps.map((s, i) => (
          <li class="flex flex-col gap-6 border-t border-cocoa-ink pt-12">
            <span class="display text-[64px] leading-none md:text-[88px]" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="font-ui text-[18px] font-semibold">
              <span class="sr-only">Paso {i + 1}: </span>
              {s.title}
            </h3>
            <p class="text-cocoa-ink/80">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
