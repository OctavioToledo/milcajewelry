---
import { Picture, getImage } from "astro:assets";
import type { ProductImage } from "../content/types";
import Icon from "./Icon.astro";

interface Props {
  images: ProductImage[];
  name: string;
}
const { images, name } = Astro.props;
const many = images.length > 1;
// Versión grande para el lightbox (el master completo, en WebP).
const large = await Promise.all(images.map((img) => getImage({ src: img.src, format: "webp", width: img.src.width })));
---

<div class="gallery flex flex-col gap-8" data-gallery>
  <div class="relative">
    <ul class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto" data-gallery-track aria-label={`Fotos de ${name}`}>
      {
        images.map((img, i) => (
          <li class="w-full shrink-0 snap-center" aria-label={`Foto ${i + 1} de ${images.length}`}>
            <button type="button" class="block w-full cursor-zoom-in" data-gallery-open={i} aria-label={`Ampliar foto ${i + 1}: ${img.alt}`}>
              <Picture
                src={img.src}
                alt={img.alt}
                widths={[375, 560, img.src.width]}
                sizes="(min-width: 768px) 50vw, 100vw"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : "auto"}
                data-vt-photo={i === 0 ? "" : undefined}
                style={i === 0 ? "view-transition-name: product-photo" : undefined}
                class="aspect-[4/5] w-full bg-milk-paper object-cover"
              />
            </button>
          </li>
        ))
      }
    </ul>
    {
      many && (
        <div class="pointer-events-none absolute inset-x-0 bottom-3 flex justify-center gap-[6px] md:hidden" aria-hidden="true">
          {images.map((_, i) => (
            <span class="h-[3px] w-[24px] bg-paper-white/60 transition-colors data-[active]:bg-paper-white" data-gallery-dot={i} data-active={i === 0 ? "" : undefined} />
          ))}
        </div>
      )
    }
  </div>

  {
    many && (
      <ul class="hidden gap-8 md:flex" aria-label="Miniaturas">
        {images.map((img, i) => (
          <li>
            <button
              type="button"
              class="block w-[88px] border border-transparent p-[2px] aria-[current=true]:border-cocoa-ink"
              data-gallery-thumb={i}
              aria-current={i === 0 ? "true" : "false"}
              aria-label={`Ver foto ${i + 1}`}
            >
              <Picture src={img.src} alt="" widths={[88, 176]} sizes="88px" formats={["avif", "webp"]} fallbackFormat="webp" class="aspect-[4/5] w-full object-cover" />
            </button>
          </li>
        ))}
      </ul>
    )
  }

  <dialog class="lightbox m-0 size-full max-h-none max-w-none bg-cocoa-ink p-0 text-milk-paper backdrop:bg-cocoa-ink" data-lightbox aria-label={`Fotos de ${name}`}>
    <div class="flex h-dvh flex-col">
      <div class="flex items-center justify-between px-[18px] py-6">
        <p class="nav-control" data-lightbox-count aria-live="polite">1 / {images.length}</p>
        <button type="button" class="-mr-2 inline-flex size-11 items-center justify-center" data-lightbox-close aria-label="Cerrar">
          <Icon name="close" size={26} />
        </button>
      </div>
      <ul class="no-scrollbar flex min-h-0 flex-1 snap-x snap-mandatory overflow-x-auto" data-lightbox-track>
        {
          images.map((img, i) => (
            <li class="relative flex w-full shrink-0 snap-center items-center justify-center overflow-hidden">
              <img
                src={large[i].src}
                alt={img.alt}
                width={img.src.width}
                height={img.src.height}
                loading="lazy"
                decoding="async"
                class="lightbox-img max-h-full w-auto max-w-full cursor-zoom-in object-contain transition-transform duration-300"
                data-zoomable
              />
            </li>
          ))
        }
      </ul>
      {
        many && (
          <div class="flex justify-center gap-12 py-6">
            <button type="button" class="inline-flex size-11 rotate-180 items-center justify-center" data-lightbox-prev aria-label="Foto anterior">
              <Icon name="arrow" size={24} />
            </button>
            <button type="button" class="inline-flex size-11 items-center justify-center" data-lightbox-next aria-label="Foto siguiente">
              <Icon name="arrow" size={24} />
            </button>
          </div>
        )
      }
      <p class="pb-6 text-center text-[12px] text-milk-paper/60">Tocá la foto para hacer zoom</p>
    </div>
  </dialog>
</div>

<style>
  /* En móvil el pinch-zoom nativo funciona dentro del lightbox. */
  .lightbox [data-lightbox-track] {
    touch-action: pan-x pinch-zoom;
  }
  .lightbox-img.is-zoomed {
    transform: scale(2.2);
    cursor: zoom-out;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-gallery]")) {
    const track = root.querySelector<HTMLElement>("[data-gallery-track]")!;
    const dots = [...root.querySelectorAll<HTMLElement>("[data-gallery-dot]")];
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")];
    const dialog = root.querySelector<HTMLDialogElement>("[data-lightbox]")!;
    const lbTrack = dialog.querySelector<HTMLElement>("[data-lightbox-track]")!;
    const lbCount = dialog.querySelector<HTMLElement>("[data-lightbox-count]")!;
    const total = track.children.length;
    let opener: HTMLElement | null = null;

    const indexOf = (el: HTMLElement) => Math.round(el.scrollLeft / el.clientWidth);
    const goTo = (el: HTMLElement, i: number, smooth = true) =>
      el.scrollTo({ left: i * el.clientWidth, behavior: smooth && !matchMedia("(prefers-reduced-motion: reduce)").matches ? "smooth" : "auto" });

    track.addEventListener(
      "scroll",
      () => {
        const i = indexOf(track);
        dots.forEach((d, j) => d.toggleAttribute("data-active", j === i));
        thumbs.forEach((t, j) => t.setAttribute("aria-current", String(j === i)));
      },
      { passive: true },
    );
    thumbs.forEach((t, i) => t.addEventListener("click", () => goTo(track, i)));

    const unzoom = () => dialog.querySelectorAll(".is-zoomed").forEach((img) => img.classList.remove("is-zoomed"));
    const updateCount = () => (lbCount.textContent = `${indexOf(lbTrack) + 1} / ${total}`);

    root.querySelectorAll<HTMLButtonElement>("[data-gallery-open]").forEach((btn) =>
      btn.addEventListener("click", () => {
        opener = btn;
        dialog.showModal();
        goTo(lbTrack, Number(btn.dataset.galleryOpen), false);
        updateCount();
      }),
    );
    lbTrack.addEventListener("scroll", () => (unzoom(), updateCount()), { passive: true });
    dialog.querySelector("[data-lightbox-close]")!.addEventListener("click", () => dialog.close());
    dialog.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => goTo(lbTrack, Math.max(0, indexOf(lbTrack) - 1)));
    dialog.querySelector("[data-lightbox-next]")?.addEventListener("click", () => goTo(lbTrack, Math.min(total - 1, indexOf(lbTrack) + 1)));
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") goTo(lbTrack, Math.min(total - 1, indexOf(lbTrack) + 1));
      if (e.key === "ArrowLeft") goTo(lbTrack, Math.max(0, indexOf(lbTrack) - 1));
    });
    dialog.addEventListener("close", () => {
      unzoom();
      goTo(track, indexOf(lbTrack), false);
      opener?.focus();
    });

    // Zoom con clic (desktop) o tap: amplía en el punto tocado y sigue el puntero.
    dialog.querySelectorAll<HTMLImageElement>("[data-zoomable]").forEach((img) => {
      img.addEventListener("click", (e) => {
        const zoomed = img.classList.toggle("is-zoomed");
        if (zoomed) setOrigin(img, e);
      });
      img.addEventListener("pointermove", (e) => {
        if (img.classList.contains("is-zoomed") && e.pointerType === "mouse") setOrigin(img, e);
      });
    });
    function setOrigin(img: HTMLImageElement, e: MouseEvent) {
      // Medimos contra la caja sin escalar (offset* ignora el transform).
      const box = img.parentElement!.getBoundingClientRect();
      const x = (e.clientX - box.left - img.offsetLeft) / img.offsetWidth;
      const y = (e.clientY - box.top - img.offsetTop) / img.offsetHeight;
      img.style.transformOrigin = `${Math.min(1, Math.max(0, x)) * 100}% ${Math.min(1, Math.max(0, y)) * 100}%`;
    }
  }
</script>
