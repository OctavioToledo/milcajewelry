---
import Icon from "./Icon.astro";
import { GIFT_MESSAGE_MAX } from "../lib/cart/types";
---

<dialog
  class="cart-drawer m-0 ml-auto h-dvh max-h-none w-full max-w-none bg-paper-white p-0 text-cocoa-ink backdrop:bg-cocoa-ink/50 md:w-[440px]"
  aria-labelledby="cart-title"
  data-cart
>
  <div class="flex h-full flex-col">
    <header class="flex items-center justify-between border-b border-cocoa-ink/15 px-[18px] py-8">
      <h2 id="cart-title" class="font-ui text-[18px] font-semibold uppercase tracking-[0.02em]">Tu pedido</h2>
      <button type="button" class="-mr-2 inline-flex size-11 items-center justify-center" data-cart-close aria-label="Cerrar el pedido">
        <Icon name="close" size={24} />
      </button>
    </header>

    <!-- Vacío -->
    <div class="flex flex-1 flex-col items-center justify-center gap-12 px-[18px] text-center" data-cart-empty>
      <p class="statement">Tu pedido está vacío</p>
      <p class="text-cocoa-ink/70">Elegí tus piezas favoritas y armalo acá.</p>
      <a href="/#catalogo" class="btn btn-solid" data-cart-close>Ver el catálogo</a>
    </div>

    <!-- Con productos -->
    <div class="hidden min-h-0 flex-1 flex-col" data-cart-filled>
      <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-[18px]">
        <ul class="divide-y divide-cocoa-ink/10" data-cart-lines aria-label="Piezas en tu pedido"></ul>

        <div class="flex flex-col gap-12 border-t border-cocoa-ink/15 py-12">
          <label class="flex min-h-11 cursor-pointer items-center gap-8">
            <input type="checkbox" class="size-5 accent-cocoa-ink" data-cart-gift />
            <span class="font-ui font-semibold">🎁 Es para regalo</span>
          </label>
          <div class="hidden flex-col gap-6" data-cart-gift-fields>
            <label for="cart-gift-message" class="text-[13px] font-medium">Mensaje para la tarjeta (opcional)</label>
            <textarea
              id="cart-gift-message"
              rows="3"
              maxlength={GIFT_MESSAGE_MAX}
              class="w-full resize-none border border-cocoa-ink/40 bg-paper-white p-8 text-[16px] focus:border-cocoa-ink"
              placeholder="Ej.: ¡Feliz cumple!"
              aria-describedby="cart-gift-count"
              data-cart-gift-message></textarea>
            <p id="cart-gift-count" class="self-end text-[12px] text-cocoa-ink/70" data-cart-gift-count>0/{GIFT_MESSAGE_MAX}</p>
          </div>
          <div class="flex flex-col gap-6">
            <label for="cart-name" class="text-[13px] font-medium">Tu nombre (opcional)</label>
            <input id="cart-name" type="text" autocomplete="given-name" class="min-h-11 w-full border border-cocoa-ink/40 bg-paper-white px-8 text-[16px] focus:border-cocoa-ink" data-cart-name />
          </div>
          <button type="button" class="self-start text-[13px] underline underline-offset-4 text-cocoa-ink/70 hover:text-cocoa-ink" data-cart-clear>Vaciar pedido</button>
        </div>
      </div>

      <footer class="flex flex-col gap-8 border-t border-cocoa-ink/15 px-[18px] pb-[calc(12px+env(safe-area-inset-bottom))] pt-12">
        <div class="flex items-baseline justify-between">
          <span class="eyebrow" data-cart-total-label>Total</span>
          <span class="font-ui text-[22px] font-semibold" data-cart-total></span>
        </div>
        <p class="hidden text-[13px] text-cocoa-ink/70" data-cart-partial>Hay piezas con precio a consultar: te pasamos el total final por WhatsApp.</p>
        <a href="#" target="_blank" rel="noopener" class="btn btn-solid w-full" data-cart-send>
          <Icon name="whatsapp" size={20} />
          Enviar pedido por WhatsApp
        </a>
        <p class="text-center text-[12px] text-cocoa-ink/70">Se abre WhatsApp con tu pedido escrito. Coordinamos pago y envío por ahí.</p>
      </footer>
    </div>
  </div>
</dialog>

<style>
  .cart-drawer[open] {
    animation: sheet-up 0.35s var(--ease-editorial);
  }
  @media (min-width: 768px) {
    .cart-drawer[open] {
      animation-name: slide-in;
    }
  }
  .cart-drawer[open]::backdrop {
    animation: fade 0.35s;
  }
  @keyframes sheet-up {
    from { transform: translateY(100%); }
  }
  @keyframes slide-in {
    from { transform: translateX(100%); }
  }
  @keyframes fade {
    from { opacity: 0; }
  }
</style>

<script>
  import { dispatch, getCart, subscribe } from "../lib/cart/store";
  import { cartTotal, itemCount, lineSubtotal } from "../lib/cart/reducer";
  import { formatPrice } from "../lib/format";
  import { buildOrderMessage, whatsappLink } from "../lib/whatsapp";
  import type { CartLine } from "../lib/cart/types";

  const dialog = document.querySelector<HTMLDialogElement>("[data-cart]")!;
  const $ = <T extends HTMLElement>(sel: string) => dialog.querySelector<T>(sel)!;
  const linesEl = $("[data-cart-lines]");
  const gift = $<HTMLInputElement>("[data-cart-gift]");
  const giftFields = $("[data-cart-gift-fields]");
  const giftMessage = $<HTMLTextAreaElement>("[data-cart-gift-message]");
  const giftCount = $("[data-cart-gift-count]");
  const nameInput = $<HTMLInputElement>("[data-cart-name]");
  const send = $<HTMLAnchorElement>("[data-cart-send]");
  let opener: Element | null = null;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const btn = "inline-flex size-11 items-center justify-center";

  function lineHtml(l: CartLine) {
    const sub = lineSubtotal(l);
    return `<li class="flex gap-12 py-12" data-key="${esc(l.key)}">
      <a href="/producto/${esc(l.slug)}" class="shrink-0"><img src="${esc(l.image)}" alt="" width="80" height="100" class="h-[100px] w-[80px] bg-milk-paper object-cover"></a>
      <div class="flex min-w-0 flex-1 flex-col gap-[2px]">
        <div class="flex items-start justify-between gap-8">
          <a href="/producto/${esc(l.slug)}" class="font-ui text-[14px] font-semibold uppercase leading-tight hover:underline">${esc(l.name)}</a>
          <button type="button" class="-mr-2 -mt-2 ${btn} text-cocoa-ink/70 hover:text-cocoa-ink" data-remove aria-label="Quitar ${esc(l.name)} del pedido">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
          </button>
        </div>
        ${l.variants.length ? `<p class="text-[13px] text-cocoa-ink/70">${l.variants.map(esc).join(" · ")}</p>` : ""}
        <div class="mt-auto flex items-center justify-between gap-8 pt-6">
          <div class="flex h-11 items-center border border-cocoa-ink/40" role="group" aria-label="Cantidad de ${esc(l.name)}">
            <button type="button" class="${btn}" data-dec aria-label="Restar una" ${l.qty <= 1 ? "disabled" : ""}>−</button>
            <span class="w-[24px] text-center font-ui font-semibold">${l.qty}</span>
            <button type="button" class="${btn}" data-inc aria-label="Sumar una">+</button>
          </div>
          <span class="font-ui font-semibold">${sub === null ? "A consultar" : formatPrice(sub)}</span>
        </div>
      </div>
    </li>`;
  }

  subscribe((cart) => {
    const count = itemCount(cart);
    document.querySelectorAll<HTMLElement>("[data-cart-count]").forEach((el) => {
      el.textContent = String(count);
      el.classList.toggle("hidden", count === 0);
    });
    document.querySelectorAll("[data-cart-open]").forEach((el) =>
      el.setAttribute("aria-label", count ? `Abrir tu pedido (${count} ${count === 1 ? "pieza" : "piezas"})` : "Abrir tu pedido"),
    );

    const filled = cart.lines.length > 0;
    $("[data-cart-empty]").classList.toggle("hidden", filled);
    $("[data-cart-filled]").classList.toggle("hidden", !filled);
    $("[data-cart-filled]").classList.toggle("flex", filled);
    if (!filled) return;

    linesEl.innerHTML = cart.lines.map(lineHtml).join("");
    const { total, partial } = cartTotal(cart);
    const allConsult = cart.lines.every((l) => l.unitPrice === null);
    $("[data-cart-total-label]").textContent = partial && !allConsult ? "Total parcial" : "Total";
    $("[data-cart-total]").textContent = allConsult ? "A consultar" : formatPrice(total);
    $("[data-cart-partial]").classList.toggle("hidden", !partial);

    gift.checked = cart.gift;
    giftFields.classList.toggle("hidden", !cart.gift);
    giftFields.classList.toggle("flex", cart.gift);
    if (document.activeElement !== giftMessage) giftMessage.value = cart.giftMessage;
    if (document.activeElement !== nameInput) nameInput.value = cart.customerName;
    giftCount.textContent = `${cart.giftMessage.length}/${giftMessage.maxLength}`;
    send.href = whatsappLink(buildOrderMessage(cart));
  });

  linesEl.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const key = target.closest<HTMLElement>("[data-key]")?.dataset.key;
    if (!key) return;
    const line = getCart().lines.find((l) => l.key === key);
    if (!line) return;
    if (target.closest("[data-remove]")) dispatch({ type: "remove", key });
    else if (target.closest("[data-inc]")) dispatch({ type: "setQty", key, qty: line.qty + 1 });
    else if (target.closest("[data-dec]")) dispatch({ type: "setQty", key, qty: line.qty - 1 });
    else return;
    // Re-render reemplaza los botones: devolvemos el foco a un lugar estable.
    const sel = target.closest("[data-inc]") ? "[data-inc]" : target.closest("[data-dec]") ? "[data-dec]" : null;
    const same = sel && linesEl.querySelector<HTMLElement>(`[data-key="${CSS.escape(key)}"] ${sel}`);
    (same && !(same as HTMLButtonElement).disabled ? same : $("[data-cart-close]")).focus();
  });

  gift.addEventListener("change", () => dispatch({ type: "setGift", gift: gift.checked }));
  giftMessage.addEventListener("input", () => dispatch({ type: "setGiftMessage", message: giftMessage.value }));
  nameInput.addEventListener("input", () => dispatch({ type: "setCustomerName", name: nameInput.value }));
  // Vaciar en dos toques, sin confirm() nativo.
  const clearBtn = $<HTMLButtonElement>("[data-cart-clear]");
  let clearTimer: number | undefined;
  clearBtn.addEventListener("click", () => {
    if (clearBtn.dataset.armed) {
      clearTimeout(clearTimer);
      delete clearBtn.dataset.armed;
      clearBtn.textContent = "Vaciar pedido";
      dispatch({ type: "clear" });
      $("[data-cart-close]").focus();
      return;
    }
    clearBtn.dataset.armed = "1";
    clearBtn.textContent = "¿Seguro? Tocá de nuevo para vaciar";
    clearTimer = window.setTimeout(() => {
      delete clearBtn.dataset.armed;
      clearBtn.textContent = "Vaciar pedido";
    }, 4000);
  });

  function open() {
    if (dialog.open) return;
    opener = document.activeElement;
    dialog.showModal();
    document.documentElement.style.overflow = "hidden";
  }
  dialog.addEventListener("close", () => {
    document.documentElement.style.overflow = "";
    if (opener instanceof HTMLElement) opener.focus();
  });
  // Clic en el fondo (fuera del panel) cierra.
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.querySelectorAll("[data-cart-close]").forEach((el) => el.addEventListener("click", () => dialog.close()));
  document.addEventListener("cart:open", open);
  document.querySelectorAll("[data-cart-open]").forEach((el) => el.addEventListener("click", open));
</script>
