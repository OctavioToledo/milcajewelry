---
import Logo from "../assets/brand/logo.svg";
import Icon from "./Icon.astro";
import { site } from "../content/site";
import { sections } from "../content/sections";
import { GENERAL_MESSAGE, whatsappLink } from "../lib/whatsapp";
---

<footer id="contacto" class="on-dark bg-cocoa-ink text-milk-paper">
  <div class="container-x grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr] md:py-24">
    <div class="flex flex-col gap-12">
      <Logo class="h-[44px] w-auto self-start text-milk-paper" aria-hidden="true" />
      <p class="statement max-w-[14ch] text-talent-peach">{sections.contacto.text}</p>
      <a class="btn btn-outline self-start border-milk-paper text-milk-paper hover:bg-milk-paper hover:text-cocoa-ink" href={whatsappLink(GENERAL_MESSAGE)} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} />
        {sections.contacto.whatsappCta}
      </a>
    </div>

    <div class="flex flex-col gap-12">
      <h2 class="eyebrow text-talent-peach">{sections.contacto.title}</h2>
      <ul class="flex flex-col gap-6 text-[15px]">
        <li>{site.location.label}</li>
        <li>
          <a class="inline-flex min-h-11 items-center gap-8 hover:underline" href={site.instagram.url} target="_blank" rel="noopener">
            <Icon name="instagram" size={18} />
            {site.instagram.handle}
          </a>
        </li>
        <li>
          <a class="inline-flex min-h-11 items-center gap-8 hover:underline" href={whatsappLink(GENERAL_MESSAGE)} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={18} />
            WhatsApp
          </a>
        </li>
      </ul>
    </div>

    <div class="flex flex-col gap-12">
      <h2 class="eyebrow text-talent-peach">{sections.guias.title}</h2>
      <ul class="flex flex-col gap-6 text-[15px]">
        {
          sections.guias.items.map((g) => (
            <li>
              <a class="inline-flex min-h-11 items-center hover:underline" href={g.href}>
                {g.title}
              </a>
            </li>
          ))
        }
        <li><a class="inline-flex min-h-11 items-center hover:underline" href="/#faq">{sections.faq.title}</a></li>
      </ul>
    </div>
  </div>

  <div class="container-x flex flex-col gap-6 border-t border-milk-paper/15 py-6 text-[12px] text-milk-paper/70 md:flex-row md:justify-between">
    <p>© {new Date().getFullYear()} {site.fullName}</p>
    <a class="hover:text-milk-paper" href={site.credit.url} target="_blank" rel="noopener">{site.credit.label}</a>
  </div>
</footer>
