---
import Icon from "./Icon.astro";
import { GENERAL_MESSAGE, whatsappLink } from "../lib/whatsapp";
---

<!-- En la ficha de producto sube por encima del CTA sticky (ver --float-offset en la página). -->
<a
  href={whatsappLink(GENERAL_MESSAGE)}
  target="_blank"
  rel="noopener"
  aria-label="Consultanos por WhatsApp"
  class="float-in fixed right-4 z-30 inline-flex size-[48px] items-center md:size-14 justify-center bg-cocoa-ink text-milk-paper transition-transform hover:-translate-y-0.5 md:right-8"
  style="bottom: calc(16px + var(--float-offset, 0px) + env(safe-area-inset-bottom));"
>
  <Icon name="whatsapp" size={26} />
</a>
