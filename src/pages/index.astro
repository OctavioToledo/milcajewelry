---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Novedades from "../components/sections/Novedades.astro";
import Catalogo from "../components/sections/Catalogo.astro";
import Regalo from "../components/sections/Regalo.astro";
import Materiales from "../components/sections/Materiales.astro";
import ComoComprar from "../components/sections/ComoComprar.astro";
import EnviosPagos from "../components/sections/EnviosPagos.astro";
import Guias from "../components/sections/Guias.astro";
import Nosotros from "../components/sections/Nosotros.astro";
import Faq from "../components/sections/Faq.astro";
import Instagram from "../components/sections/Instagram.astro";
import { site } from "../content/site";
import { faq } from "../content/faq";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      name: site.fullName,
      alternateName: site.name,
      url: site.url,
      inLanguage: "es-AR",
    },
    {
      "@type": "JewelryStore",
      "@id": `${site.url}/#store`,
      name: site.fullName,
      description: site.description,
      url: site.url,
      logo: new URL("/icon-512.png", site.url).href,
      image: new URL("/og.jpg", site.url).href,
      sameAs: [site.instagram.url],
      address: {
        "@type": "PostalAddress",
        addressLocality: site.location.city,
        addressRegion: site.location.province,
        addressCountry: "AR",
      },
      paymentAccepted: "Efectivo, Transferencia",
      currenciesAccepted: "ARS",
      areaServed: { "@type": "Country", name: "Argentina" },
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<BaseLayout jsonLd={jsonLd}>
  <Hero />
  <Marquee items={site.marquee} class="border-y border-cocoa-ink bg-cocoa-ink py-[18px] text-milk-paper md:py-6" />
  <Novedades />
  <Catalogo />
  <Regalo />
  <Materiales />
  <ComoComprar />
  <EnviosPagos />
  <Guias />
  <Nosotros />
  <Faq />
  <Instagram />
</BaseLayout>
