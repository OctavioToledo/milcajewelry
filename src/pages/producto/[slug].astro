---
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Gallery from "../../components/Gallery.astro";
import ProductBuy from "../../components/ProductBuy.astro";
import ProductCard from "../../components/ProductCard.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import Price from "../../components/Price.astro";
import { getCategoryName, getProducts, getRelatedProducts } from "../../lib/catalog";
import { care } from "../../content/care";
import { site } from "../../content/site";
import type { Product } from "../../content/types";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const related = await getRelatedProducts(product, 4);
const careGuide = care.find((c) => c.id === product.careGuide);
const url = new URL(`/producto/${product.slug}/`, Astro.site ?? site.url).href;
const categoryName = getCategoryName(product.category);

const images = await Promise.all(product.images.map((img) => getImage({ src: img.src, format: "jpeg", width: img.src.width })));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.description,
  image: images.map((i) => new URL(i.src, Astro.site ?? site.url).href),
  sku: product.id,
  category: categoryName,
  material: product.material,
  brand: { "@type": "Brand", name: site.fullName },
  url,
  ...(product.price !== null && {
    offers: {
      "@type": "Offer",
      price: product.price,
      priceCurrency: "ARS",
      url,
      availability: product.status === "agotado" ? "https://schema.org/OutOfStock" : product.status === "ultimas-unidades" ? "https://schema.org/LimitedAvailability" : "https://schema.org/InStock",
    },
  }),
};
const description = product.description.length > 155 ? `${product.description.slice(0, 152)}…` : product.description;
---

<BaseLayout title={product.name} description={description} image={product.images[0].src} imageAlt={product.images[0].alt} type="product" jsonLd={jsonLd}>
  <nav aria-label="Ruta" class="container-x pt-6 md:pt-8">
    <ol class="nav-control flex flex-wrap items-center gap-6 text-cocoa-ink/70">
      <li><a href="/" class="inline-flex min-h-11 items-center hover:text-cocoa-ink">Inicio</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`/?categoria=${product.category}#catalogo`} class="inline-flex min-h-11 items-center hover:text-cocoa-ink">{categoryName}</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-cocoa-ink">{product.name}</li>
    </ol>
  </nav>

  <article class="container-x grid gap-12 pb-16 md:grid-cols-12 md:gap-12 md:pb-24">
    <div class="-mx-[18px] md:col-span-7 md:mx-0 lg:col-span-6">
      <Gallery images={product.images} name={product.name} />
    </div>

    <div class="flex flex-col gap-12 md:col-span-5 md:col-start-8 lg:col-span-5 lg:col-start-8">
      <div class="flex flex-col gap-8 md:sticky md:top-[96px]">
        <StatusBadge status={product.status} isNew={product.isNew} class="self-start" />
        <h1 class="display text-[clamp(44px,12vw,76px)]" data-split="chars">{product.name}</h1>
        <p class="eyebrow text-cocoa-ink/70" data-reveal="up" style="--d: 250ms">{product.material}</p>
        <div data-reveal="up" style="--d: 330ms"><Price value={product.price} class="font-ui text-[22px] font-semibold" /></div>

        <div class="mt-6" data-reveal="up" style="--d: 420ms">
          <ProductBuy product={product} url={url} />
        </div>

        <div class="mt-6 flex flex-col gap-12 border-t border-cocoa-ink pt-12" data-reveal="wipe" style="--d: 520ms">
          <p class="text-[16px] leading-[1.5]">{product.description}</p>
          {
            product.details && product.details.length > 0 && (
              <div class="flex flex-col gap-6">
                <h2 class="eyebrow">Detalles</h2>
                <ul class="flex flex-col gap-[2px] text-cocoa-ink/80">
                  {product.details.map((d) => (
                    <li>— {d}</li>
                  ))}
                </ul>
              </div>
            )
          }
          {
            careGuide && (
              <details class="group border-t border-cocoa-ink/20 pt-8">
                <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between eyebrow [&::-webkit-details-marker]:hidden">
                  Cuidados · {careGuide.material}
                  <span class="text-[18px] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <ul class="flex flex-col gap-[2px] pb-6 text-cocoa-ink/80">
                  {careGuide.tips.map((t) => (
                    <li>— {t}</li>
                  ))}
                </ul>
                <a href="/cuidados" class="text-[14px] underline underline-offset-4">Ver la guía de cuidados</a>
              </details>
            )
          }
        </div>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section aria-labelledby="relacionados-title" class="bg-milk-paper py-16 md:py-24">
        <div class="container-x flex flex-col gap-8">
          <h2 id="relacionados-title" class="statement" data-split="words">
            También te puede gustar
          </h2>
          <ul class="grid grid-cols-2 gap-x-12 gap-y-8 md:grid-cols-4" data-stagger="card">
            {related.map((p) => (
              <li>
                <ProductCard product={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style is:global>
  /* Móvil: el botón flotante de WhatsApp sube por encima de la barra de compra sticky. */
  @media (max-width: 767px) {
    :root {
      --float-offset: 76px;
    }
    body {
      padding-bottom: calc(76px + env(safe-area-inset-bottom));
    }
  }
</style>
