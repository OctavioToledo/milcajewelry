---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada">
  <section class="container-x flex min-h-[60dvh] flex-col items-start justify-center gap-12 py-16">
    <p class="display text-[clamp(80px,25vw,200px)]">404</p>
    <h1 class="statement">Esta página no existe</h1>
    <p class="text-cocoa-ink/80">Puede que la pieza ya no esté en el catálogo.</p>
    <a href="/#catalogo" class="btn btn-solid">Ver el catálogo</a>
  </section>
</BaseLayout>
