---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ringSizes } from "../content/ring-sizes";
import { getProducts } from "../lib/catalog";

const ringsWithSize = (await getProducts()).filter((p) => p.variants?.some((v) => v.type === "talle"));
---

<BaseLayout title="Guía de talles de anillos" description="Cómo medir tu talle de anillo en casa con un hilo y una regla, y tabla de equivalencias.">
  <section class="container-x grid gap-12 py-12 md:grid-cols-12 md:py-24">
    <div class="flex flex-col gap-12 md:col-span-5">
      <p class="eyebrow">Guía</p>
      <h1 class="display text-[clamp(48px,13vw,110px)]">Talles de anillos</h1>
      <p class="text-[17px]">{ringSizes.intro}</p>
      <ol class="flex flex-col gap-12">
        {
          ringSizes.steps.map((s, i) => (
            <li class="flex gap-12 border-t border-cocoa-ink pt-8">
              <span class="display text-[40px] leading-none" aria-hidden="true">
                {i + 1}
              </span>
              <span class="pt-1">{s}</span>
            </li>
          ))
        }
      </ol>
      <p class="bg-join-blush p-[18px] text-[14px]">{ringSizes.tip}</p>
    </div>

    <div class="md:col-span-6 md:col-start-7">
      <table class="w-full border-collapse text-left">
        <caption class="eyebrow pb-8 text-left">Tabla de equivalencias</caption>
        <thead>
          <tr class="border-b border-cocoa-ink">
            <th scope="col" class="py-8 font-ui font-semibold">Talle</th>
            <th scope="col" class="py-8 font-ui font-semibold">Contorno (mm)</th>
            <th scope="col" class="py-8 font-ui font-semibold">Diámetro (mm)</th>
          </tr>
        </thead>
        <tbody>
          {
            ringSizes.table.map((r) => (
              <tr class="border-b border-cocoa-ink/15">
                <th scope="row" class="py-12 font-ui text-[18px] font-semibold">
                  {r.size}
                </th>
                <td class="py-12">{r.circumference}</td>
                <td class="py-12">{r.diameter.toLocaleString("es-AR")}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      {
        ringsWithSize.length > 0 && (
          <div class="mt-12 flex flex-col gap-8">
            <p class="eyebrow">Anillos con talle</p>
            <ul class="flex flex-wrap gap-8">
              {ringsWithSize.map((p) => (
                <li>
                  <a class="btn btn-outline" href={`/producto/${p.slug}`}>
                    {p.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
